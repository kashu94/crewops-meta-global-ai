# Meta Model API (https://dev.meta.ai)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# Hosted models
CREWOPS_ADVISOR_MODEL=muse-spark-1.3
CREWOPS_VISION_MODEL=muse-spark-1.3
CREWOPS_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
CREWOPS_SEGMENT_MODEL=sam-3.1

# Muse Spark Open, served by an inference partner (OpenAI-compatible endpoint)
OPEN_MODEL_API_KEY=
OPEN_MODEL_BASE_URL=https://inference.baseten.co/v1
CREWOPS_OPEN_MODEL=meta-models/muse-spark-open-1026

# Llama Prompt Guard 2 classifier endpoint (optional; pattern screening always runs)
PROMPT_GUARD_URL=
PROMPT_GUARD_TOKEN=

# Append every model call's token use to this JSON-lines file (optional)
CREWOPS_USAGE_LOG=

# Where the operation lives: memory (demo data, changes last until restart) or dynamodb
CREWOPS_STORE=memory

# AWS: the operation is stored in DynamoDB. Keys live in the AWS profile, never here.
AWS_PROFILE=crewops-meta
AWS_REGION=ap-south-1
CREWOPS_STAGE=dev
# Defaults to crewops-meta-<stage>-operation
CREWOPS_TABLE=
# Set to http://localhost:8000 to use DynamoDB Local instead of AWS
CREWOPS_DYNAMODB_ENDPOINT=
